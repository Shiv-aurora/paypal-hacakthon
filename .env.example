# PayPal sandbox app (developer.paypal.com -> Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Claude (console.anthropic.com). Leave empty to run the scripted demo verifier.
ANTHROPIC_API_KEY=

# Platform fee kept by Cleared on each sale, in percent
CLEARED_FEE_PERCENT=3

# Sandbox *personal* account email that receives seller payouts in the demo listings
SELLER_SANDBOX_EMAIL=
